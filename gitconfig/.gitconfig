[include]
    path = ~/.gitconfig.local

[init]
	templatedir = ~/git/templates
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[url "git@github.com:"]
	insteadOf = https://github.com/
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3
